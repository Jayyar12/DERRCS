# DERRCS Root Git Ignore File

# 1. Environment Secrets (CRITICAL)
.env
.env.local
.env.*.local
!.env.example

# 2. Node Dependencies and Build Artifacts
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Python Virtual Environments & Bytecode
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 4. User Media Uploads
uploads/*
!uploads/.gitkeep

# 5. Operating System & Editor Junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 6. Graphify Artifacts
.graphify/
graphify-out/
