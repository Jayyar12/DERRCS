# DERRCS Environment Variables
# Copy this file to .env before starting containers: cp .env.example .env

# 1. APPLICATION ENVIRONMENT
NODE_ENV=development
API_PORT=5000
PYTHON_PORT=8000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# 2. POSTGRESQL WITH POSTGIS CONFIGURATION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=derrcs_db
POSTGRES_USER=derrcs_user
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://derrcs_user:your_postgres_password@postgres:5432/derrcs_db

# 3. RABBITMQ MESSAGE BROKER CONFIGURATION
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=derrcs_rabbit
RABBITMQ_DEFAULT_PASS=your_rabbit_password
RABBITMQ_URL=amqp://derrcs_rabbit:your_rabbit_password@rabbitmq:5672

# 4. ARTIFICIAL INTELLIGENCE (GOOGLE GEMINI API)
# Obtain a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6IYYShbL5P9OwPpWadILehMLsYHdSuBLg875_udCmfCvg

# 5. ALGORITHM THRESHOLD PARAMETERS
DBSCAN_EPSILON_METERS=100
DBSCAN_MIN_POINTS=2
REPORT_RATE_LIMIT_PER_MINUTE=10

# 6. LOCAL MEDIA STORAGE PATH
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5
